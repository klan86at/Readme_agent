# ─────────────────────────────────────────────
# Codebase Reader — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────

# LLM Provider (choose: "google" | "openai")
LLM_PROVIDER=google

# Google Gemini (required when LLM_PROVIDER=google)
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemini-1.5-flash

# OpenAI (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# API server settings
API_HOST=0.0.0.0
API_PORT=8000

# Directory where generated docs are saved
OUTPUT_DIR=./outputs

# Temporary directory for cloned repos (leave empty to use system temp)
CLONE_TMP_DIR=

# Maximum repo size to accept in MB (safety guard)
MAX_REPO_SIZE_MB=500

# Logging level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO
